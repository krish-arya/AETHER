# Project AETHER -- environment configuration template.
# Copy to `.env` and adjust. `.env` is git-ignored: never commit real credentials.
# Everything here has a working local-development default, so `.env` is optional.

# ---------------------------------------------------------------- application
AETHER_ENVIRONMENT=local            # local | test | staging | production
AETHER_LOG_LEVEL=INFO

# PostgreSQL (the supported database). Matches docker-compose.yml when the backend
# runs on the host and Postgres runs in Docker.
AETHER_DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether
# No Docker available? A local SQLite file works for development and tests:
# AETHER_DATABASE_URL=sqlite+aiosqlite:///./aether_dev.db

AETHER_REDIS_URL=redis://localhost:6379/0
# Celery uses AETHER_REDIS_URL unless these are set:
# AETHER_CELERY_BROKER_URL=
# AETHER_CELERY_RESULT_BACKEND=

# Browser origins allowed to call the API (JSON list).
AETHER_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------- docker compose (local)
# Development-only credentials. Compose publishes ports on 127.0.0.1 only.
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_DB=aether
# Change a host port if it is already in use:
# AETHER_POSTGRES_PORT=5432
# AETHER_REDIS_PORT=6379
# AETHER_API_PORT=8000
# AETHER_WEB_PORT=3000

# ------------------------------------------------------------------- frontend
# Address at which the *browser* reaches the API. Public by design (inlined into the
# JavaScript bundle at build time) -- never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------- tests
# Enables the PostgreSQL integration tests (they create and drop a scratch database):
# AETHER_TEST_POSTGRES_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether

# ----------------------------------------------------------- LLM engine (Phase 3)
# Any OpenAI-compatible endpoint; no provider or model is hardcoded. Used by the API
# (POST /api/v1/news/analyze answers 503 while BASE_URL / MODEL are unset) and by
# scripts/analyze_news.py and scripts/evaluate_llm.py (which otherwise use the provider
# in configs/llm.yaml). See docs/llm-engine.md.
#
# Local Ollama (the setup the engine was verified against; no key needed):
# AETHER_LLM_PROVIDER=ollama
# AETHER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AETHER_LLM_MODEL=qwen2.5:3b
# AETHER_LLM_EMBEDDING_MODEL=nomic-embed-text
#
# OpenAI (implemented but NOT yet verified against the live API):
# AETHER_LLM_PROVIDER=openai
# AETHER_LLM_BASE_URL=https://api.openai.com/v1
# AETHER_LLM_MODEL=gpt-6-luna          # id reported for OpenAI "Luna"; confirm with GET /v1/models
# AETHER_LLM_API_KEY=                 # secret: only ever in .env / the environment
#
# Engine thresholds, aliases and aggregation settings (default shown):
# AETHER_LLM_CONFIG=configs/llm.yaml
